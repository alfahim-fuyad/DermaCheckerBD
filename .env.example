# Django local environment.
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Set to 'True' in production.
DJANGO_DEBUG=True

# Comma-separated host names. In production, your Render domain is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.replit.dev

# A long, random secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-in-production-please-32chars

# ---- Database ----
# Leave LOCAL_DB_HOST commented to use SQLite (db/db.sqlite3).
# For PostgreSQL installed directly on your PC, uncomment and fill these:
# LOCAL_DB_HOST=127.0.0.1
# LOCAL_DB_PORT=5432
# LOCAL_DB_NAME=dermacheckerBD
# LOCAL_DB_USER=postgres
# LOCAL_DB_PASSWORD=
# LOCAL_DB_SSLMODE=disable
#
# For a hosted PostgreSQL database, use DATABASE_URL instead:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ---- ML model ----
# 'keras' = fine-tuned ResNet50 HAM10000 model (default).
# 'mock'  = deterministic mock, useful for demos and tests.
# 'onnx'  = load an ONNX model (requires onnxruntime installed by you).
# 'api'   = forward every upload to a FastAPI service (see AI_API_URL below).
#           Use this when the real ResNet50 model lives in a separate
#           FastAPI process and Django should NOT load TensorFlow.
ML_MODEL_BACKEND=keras
# Optional public Google Drive share link; downloaded at startup when the model
# is missing. On Render, the default cache path is /tmp/dermacheckerbd/.
# MODEL_GDRIVE_URL=https://drive.google.com/file/d/FILE_ID/view?usp=sharing
# Defaults to the attached model when MODEL_GDRIVE_URL is not set. Override only
# if you keep the model elsewhere.
# ML_MODEL_PATH=/path/to/resnet50_finetuned.keras
ML_MODEL_INPUT_SIZE=224
ML_MODEL_CLASSES=akiec,bcc,bkl,df,mel,nv,vasc
ML_MODEL_RESAMPLE=BILINEAR

# ---- FastAPI prediction service (only used when ML_MODEL_BACKEND=api) ----
# Local dev:  FastAPI on :8000, Django on :8001+ -> AI_API_URL=http://127.0.0.1:8000
# Production: set AI_API_URL to your deployed FastAPI service's public URL
#             (e.g. https://derma-ai.onrender.com).
# AI_API_URL=http://127.0.0.1:8000
# Optional bearer token if your FastAPI service requires authentication.
# AI_API_TOKEN=
# Per-request timeout (seconds) for the /predict call.
# AI_API_TIMEOUT=120

# ---- Gemini chatbot ----
# Get a key from https://aistudio.google.com/app/apikey
# Leave blank to run the chatbot in offline (canned-response) mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHATBOT_RATE_LIMIT=10/m

# ---- Image quality thresholds (Smart Photo Guide) ----
IMG_MIN_DIMENSION=200
IMG_MAX_DIMENSION=4096
IMG_BLUR_THRESHOLD=100.0
IMG_BRIGHTNESS_MIN=40
IMG_BRIGHTNESS_MAX=220

# ---- Reliability check transforms ----
RELIABILITY_TRANSFORMS=brightness_up,brightness_down,contrast_up,contrast_down,slight_rotation

# ---- Similar Case Explorer (stubbed by default) ----
SIMILAR_CASES_ENABLED=False
# SIMILAR_CASES_REFERENCE_DIR=/path/to/reference_images

# ---- Image retention (days). 0 = keep forever. ----
IMAGE_RETENTION_DAYS=0

# ---- Geoapify Places API (Nearby Doctors & Hospitals) ----
# Get a key from https://myprojects.geoapify.com/ and paste it here.
# Leave blank to disable the search endpoints (the page still renders,
# but every search returns a clean "API not configured" message).
# The key is read server-side only; it is NEVER exposed to the browser
# via Django templates or CSRF-protected AJAX endpoints.
GEOAPIFY_API_KEY=
# Optional overrides (defaults shown):
# DOCTOR_SEARCH_RADIUS_KM=5
# DOCTOR_SEARCH_MAX_RESULTS=20
# GEOAPIFY_TIMEOUT=10
# GEOAPIFY_CACHE_TTL=300
